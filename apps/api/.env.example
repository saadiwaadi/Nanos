# Postgres connection (Neon) — real value lives in .env (gitignored)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: http://localhost:4000/auth/google/callback
GOOGLE_CLIENT_ID="set-me"
GOOGLE_CLIENT_SECRET="set-me"

# Frontend origin allowed by CORS
WEB_ORIGIN="http://localhost:3000"

# API port (defaults to 4000)
# PORT=4000
