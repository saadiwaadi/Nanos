[TEMPLATE]
# nanos.pk — environment variables
#
# Local dev services have been replaced with cloud-hosted equivalents:
#   Postgres → Neon
#   Redis     → Upstash
#
# Copy this file to .env and fill in the values from your Neon and Upstash
# dashboards. The API reads DATABASE_URL and REDIS_URL from apps/api/.env.
#
# If you later want to run Postgres + Redis locally via Docker, see the
# legacy docker-compose.yml in the repo root (kept for reference only).
